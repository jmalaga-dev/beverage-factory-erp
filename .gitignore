# =========================================================
# .gitignore - Fabrica V2
# Lo que Git debe IGNORAR (nunca subir a GitHub)
# =========================================================

# Secretos y configuracion sensible
*.env
.env
.env.local
# Cualquier variante .env.ALGO (.env.demo lo genera el lanzador de demo con
# la contrasena de su rol de PostgreSQL). Ojo: `*.env` NO cubre estos casos,
# porque ahi el .env queda al principio y no como extension. La excepcion es
# .env.example, que SI se versiona a proposito: es la plantilla sin secretos.
.env.*
!.env.example
backend/.env.*
!backend/.env.example
*.key

# Datos personales (CV) - se conserva en disco local, no se publica
/CV.md

# Datos reales (clientes, ventas, deudas reales)
datos_reales/
*_reales.*
*.backup
*.dump

# Power BI (el .pbix en modo Import cachea una copia completa de los datos)
*.pbix

# Archivos viejos o temporales
*_OLD.*
*_old.*
*.tmp
*.bak

# Dependencias (cuando agregues backend/frontend)
node_modules/
__pycache__/
*.pyc
venv/
.venv/

# Frontend compilado: lo genera `npm run build` (y el lanzador local solo).
# Es producto de la compilacion, no fuente.
frontend/dist/

# Registros y estado local del lanzador (mejora 8.8)
lanzador/*.log
lanzador/.compilado

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Carpetas de editores
.vscode/
.idea/

# Scripts de prueba (no son parte del backend)
backend/pruebas/