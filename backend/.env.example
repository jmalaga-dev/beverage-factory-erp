# Plantilla de configuracion del backend. Copiar como `.env` y completar.
#
#   cp .env.example .env
#
# El `.env` real NUNCA se versiona (esta en .gitignore): lleva la contrasena
# de la base. Este ejemplo si, para que se sepa que variables hacen falta.

# --- Conexion a PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fabrica_V2
DB_USER=postgres
DB_PASSWORD=cambiame

# --- Origenes permitidos para CORS ---
# De donde puede pedirle datos el frontend, separados por coma. En desarrollo
# es Vite (5173); en Docker el frontend se sirve con nginx en otro puerto, y
# si ese origen no esta aca el navegador bloquea todas las llamadas.
# Si se deja vacio, el backend usa los dos valores de desarrollo.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
